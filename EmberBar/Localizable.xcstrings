            "value": "Tempo rimanente"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo até ficar pronta"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas do gotowości"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid tills klar"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid til klar"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid til klar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aika valmiiseen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備完了までの時間"
          }
        }
      }
    },
    "Time until ready shows while the drink heats up or cools down; otherwise the temperature is shown.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tijd tot klaar verschijnt terwijl je drankje opwarmt of afkoelt; anders zie je de temperatuur."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps restant s'affiche pendant que la boisson chauffe ou refroidit ; sinon, la température s'affiche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeit bis fertig erscheint, während das Getränk aufheizt oder abkühlt; sonst wird die Temperatur angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo restante aparece mientras la bebida se calienta o se enfría; si no, se muestra la temperatura."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo rimanente appare mentre la bevanda si scalda o si raffredda; altrimenti viene mostrata la temperatura."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo restante aparece enquanto a bebida aquece ou arrefece; caso contrário, é mostrada a temperatura."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas do gotowości widać, gdy napój się nagrzewa lub stygnie; w innym razie widać temperaturę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid tills klar visas medan drycken värms eller svalnar; annars visas temperaturen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid til klar vises, mens drikken varmes op eller køler af; ellers vises temperaturen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid til klar vises mens drikken varmes opp eller kjøles ned; ellers vises temperaturen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aika valmiiseen näkyy, kun juoma lämpenee tai jäähtyy; muuten näytetään lämpötila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温めている間や冷めている間は残り時間を、それ以外は温度を表示します。"
          }
        }
      }
    },
