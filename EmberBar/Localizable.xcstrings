    "A cup counts when the mug goes from filled to empty. Amounts are estimates and stay on this Mac.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een kop telt mee als de mok van gevuld naar leeg gaat. Hoeveelheden zijn schattingen en blijven op deze Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tasse est comptée quand elle passe de pleine à vide. Les quantités sont estimées et restent sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Becher zählt, wenn er von gefüllt zu leer wechselt. Mengen sind geschätzt und bleiben auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una taza cuenta cuando pasa de llena a vacía. Las cantidades son estimaciones y se quedan en este Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tazza conta quando passa da piena a vuota. Le quantità sono stime e restano su questo Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma caneca conta quando passa de cheia a vazia. As quantidades são estimativas e ficam neste Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kubek liczy się, gdy z pełnego staje się pusty. Ilości są szacunkowe i zostają na tym Macu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En kopp räknas när muggen går från fylld till tom. Mängderna är uppskattningar och stannar på den här Macen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En kop tæller, når kruset går fra fyldt til tomt. Mængderne er skøn og bliver på denne Mac."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En kopp telles når kruset går fra fullt til tomt. Mengdene er anslag og blir på denne Macen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuppi lasketaan, kun muki muuttuu täydestä tyhjäksi. Määrät ovat arvioita ja pysyvät tässä Macissa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マグが満杯から空になると1杯と数えます。量は推定値で、このMacにのみ保存されます。"
          }
        }
      }
    },
