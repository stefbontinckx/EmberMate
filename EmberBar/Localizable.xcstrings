    "Battery at %@. Put the mug on its coaster to keep it warm.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Batterij op %@. Zet de mok op de onderzetter om hem warm te houden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
