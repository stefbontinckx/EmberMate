    "When off, the window shows how much is in the mug and what you drank today instead.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Staat dit uit, dan toont het venster in de plaats hoeveel er in de mok zit en wat je vandaag dronk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, la fenêtre affiche plutôt le contenu de la tasse et ce que vous avez bu aujourd'hui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aus, zeigt das Fenster stattdessen, wie viel im Becher ist und was du heute getrunken hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, la ventana muestra cuánto queda en la taza y lo que has bebido hoy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, la finestra mostra quanto c'è nella tazza e cosa hai bevuto oggi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desativado, a janela mostra quanto há na caneca e o que bebeu hoje."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy wyłączone, okno pokazuje, ile jest w kubku i ile dziś wypito."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När det är av visar fönstret i stället hur mycket som finns i muggen och vad du druckit i dag."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når det er slået fra, viser vinduet i stedet, hvor meget der er i kruset, og hvad du har drukket i dag."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når det er av, viser vinduet i stedet hvor mye som er i kruset og hva du har drukket i dag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun pois päältä, ikkuna näyttää mukin sisällön ja tämän päivän juomasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、代わりにマグの残量と今日飲んだ量を表示します。"
          }
        }
      }
    },
