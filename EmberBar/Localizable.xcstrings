    "Use up to 16 letters, digits, spaces or simple punctuation.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik maximaal 16 letters, cijfers, spaties of eenvoudige leestekens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez jusqu'à 16 lettres, chiffres, espaces ou signes simples."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 16 Buchstaben, Ziffern, Leerzeichen oder einfache Satzzeichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa hasta 16 letras, números, espacios o signos sencillos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa fino a 16 lettere, cifre, spazi o punteggiatura semplice."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use até 16 letras, algarismos, espaços ou pontuação simples."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj do 16 liter, cyfr, spacji lub prostych znaków."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd högst 16 bokstäver, siffror, mellanslag eller enkla tecken."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug op til 16 bogstaver, tal, mellemrum eller simple tegn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk opptil 16 bokstaver, tall, mellomrom eller enkle tegn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä enintään 16 kirjainta, numeroa, välilyöntiä tai yksinkertaista merkkiä."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
