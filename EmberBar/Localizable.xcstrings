    "Click to set, hold to save the current target to this preset": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik om in te stellen, houd vast om de huidige temperatuur hierin te bewaren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour appliquer, maintenez pour y enregistrer la cible actuelle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken zum Einstellen, halten, um das aktuelle Ziel hier zu speichern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para aplicar, mantén pulsado para guardar aquí el objetivo actual"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic per impostare, tieni premuto per salvare qui l'obiettivo attuale"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para aplicar, mantenha para guardar aqui o objetivo atual"
