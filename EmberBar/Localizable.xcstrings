        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij, aby ustawić; przytrzymaj, aby zapisać tu obecny cel"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka för att ställa in, håll in för att spara nuvarande mål här"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik for at indstille, hold nede for at gemme det aktuelle mål her"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk for å stille inn, hold inne for å lagre gjeldende mål her"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsauta asettaaksesi, pidä painettuna tallentaaksesi nykyisen tavoitteen"
          }
        },
