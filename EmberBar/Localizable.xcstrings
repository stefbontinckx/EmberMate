    "Counts from the moment you fill the mug. Turn heating back on with the power button or a preset.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telt vanaf het moment dat je de mok vult. Zet verwarmen weer aan met de aan/uit-knop of een preset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte à partir du remplissage de la tasse. Rallumez le chauffage avec le bouton marche/arrêt ou un préréglage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt ab dem Befüllen des Bechers. Schalte das Heizen über die Ein/Aus-Taste oder eine Voreinstellung wieder ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta desde que llenas la taza. Vuelve a activar el calor con el botón de encendido o un ajuste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta dal momento in cui riempi la tazza. Riattiva il riscaldamento con il pulsante di accensione o una preimpostazione."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta a partir do momento em que enche a caneca. Volte a ligar o aquecimento com o botão ou uma predefinição."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczone od napełnienia kubka. Włącz grzanie ponownie przyciskiem zasilania lub ustawieniem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Räknas från att du fyller muggen. Slå på värmen igen med strömknappen eller en förinställning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tæller fra det øjeblik, du fylder kruset. Tænd for varmen igen med tænd/sluk-knappen eller en forudindstilling."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teller fra du fyller kruset. Slå på varmen igjen med av/på-knappen eller et forhåndsvalg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasketaan mukin täyttämisestä. Käynnistä lämmitys uudelleen virtapainikkeella tai esiasetuksella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マグに注いだ時点から計測します。電源ボタンかプリセットで加熱を再開できます。"
          }
        }
      }
    },
