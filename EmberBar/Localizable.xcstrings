    "Tip: hold a preset in the menu bar window to save the current target to it.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: houd een preset ingedrukt in het menubalkvenster om de huidige temperatuur erin te bewaren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : maintenez un préréglage dans la fenêtre de la barre des menus pour y enregistrer la cible actuelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Halte eine Voreinstellung im Menüleistenfenster gedrückt, um das aktuelle Ziel darin zu speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: mantén pulsado un ajuste en la ventana de la barra de menús para guardar en él el objetivo actual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimento: tieni premuta una preimpostazione nella finestra della barra dei menu per salvarvi l'obiettivo attuale."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: mantenha premida uma predefinição na janela da barra de menus para lhe guardar o objetivo atual."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: przytrzymaj ustawienie w oknie paska menu, aby zapisać w nim obecny cel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips: håll in en förinställning i menyradsfönstret för att spara nuvarande mål i den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: hold en forudindstilling nede i menulinjevinduet for at gemme det aktuelle mål i den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips: hold inne et forhåndsvalg i menylinjevinduet for å lagre gjeldende mål i det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinkki: pidä esiasetusta painettuna valikkorivin ikkunassa tallentaaksesi siihen nykyisen tavoitteen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：メニューバーのウインドウでプリセットを長押しすると、現在の目標を保存できます。"
          }
        }
      }
    },
