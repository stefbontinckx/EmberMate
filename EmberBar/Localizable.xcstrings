    "The model sets the capacity used for volume estimates. The mug only senses roughly how full it is, so amounts are estimates.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model bepaalt de inhoud voor de schattingen. De mok meet maar ruwweg hoe vol hij is, dus hoeveelheden zijn schattingen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle définit la contenance utilisée pour les estimations. La tasse ne mesure son niveau qu'approximativement : les quantités sont estimées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell bestimmt das Fassungsvermögen für die Schätzungen. Der Becher erkennt den Füllstand nur grob, Mengen sind daher geschätzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo define la capacidad usada en las estimaciones. La taza solo detecta su nivel de forma aproximada, así que las cantidades son estimaciones."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello stabilisce la capacità per le stime. La tazza rileva il livello solo approssimativamente, quindi le quantità sono stime."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo define a capacidade usada nas estimativas. A caneca só deteta o nível aproximadamente, por isso as quantidades são estimativas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model określa pojemność do szacunków. Kubek tylko w przybliżeniu wykrywa poziom, więc ilości są szacunkowe."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen styr volymen som används för uppskattningar. Muggen känner bara ungefär hur full den är, så mängderna är uppskattningar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen bestemmer kapaciteten til skønnene. Kruset registrerer kun groft, hvor fyldt det er, så mængderne er skøn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen bestemmer kapasiteten for anslagene. Kruset registrerer bare omtrent hvor fullt det er, så mengdene er anslag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Malli määrää arvioissa käytettävän tilavuuden. Muki tunnistaa täyttöasteen vain karkeasti, joten määrät ovat arvioita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルによって推定に使う容量が決まります。マグは液量をおおまかにしか検知できないため、量は推定値です。"
          }
        }
      }
    },
    "Time until ready": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd tot klaar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps restant"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit bis fertig"
          }
        },
        "es": {
