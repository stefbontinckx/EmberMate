    "Hold the button on the bottom of the mug until the light blinks blue, then click Detect.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de knop onderaan de mok ingedrukt tot het lampje blauw knippert en klik dan op Herkennen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le bouton sous la tasse jusqu'à ce que le voyant clignote en bleu, puis cliquez sur Détecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Taste unten am Becher gedrückt, bis das Licht blau blinkt, und klicke dann auf Erkennen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el botón de la base hasta que la luz parpadee en azul y haz clic en Detectar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il pulsante sotto la tazza finché la luce lampeggia in blu, poi fai clic su Rileva."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha premido o botão na base até a luz piscar a azul e clique em Detetar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj przycisk na spodzie kubka, aż światło zacznie migać na niebiesko, a potem kliknij Wykryj."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll in knappen under muggen tills lampan blinkar blått och klicka sedan på Identifiera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold knappen under kruset inde, til lyset blinker blåt, og klik derefter på Find."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold inne knappen under kruset til lyset blinker blått, og klikk deretter på Finn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä mukin pohjan painiketta, kunnes valo vilkkuu sinisenä, ja napsauta sitten Tunnista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マグ底面のボタンをライトが青く点滅するまで押し続け、「検出」をクリックしてください。"
          }
        }
      }
    },
