    "%@ stopped heating after %lld minutes.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is gestopt met verwarmen na %2$lld minuten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a arrêté de chauffer après %2$lld minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ heizt nach %2$lld Minuten nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dejó de calentar tras %2$lld minutos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha smesso di scaldare dopo %2$lld minuti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ deixou de aquecer após %2$lld minutos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ przestał grzać po %2$lld minutach."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ slutade värma efter %2$lld minuter."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stoppede opvarmningen efter %2$lld minutter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sluttet å varme etter %2$lld minutter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lopetti lämmityksen %2$lld minuutin jälkeen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は%2$lld分後に加熱を停止しました。"
          }
        }
      }
    },
